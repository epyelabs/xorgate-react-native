{
  "compilerOptions": {
    "target": "ES2022",
    // No DOM lib: this package must compile against the React Native runtime
    // only. Anything that needs `window`, `document` or `HTMLVideoElement`
    // belongs in @xorgate/react's browser wrapper, not here.
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@xorgate/react-native": ["./src/index.ts"] }
  },
  "include": ["src", "test", "scripts"]
}
